Falls verbose=False nicht verfügbar ist (ältere Version), kannst du Python dazu bringen, die Ausgabe temporär zu "schlucken":

import sys
import os
import contextlib

@contextlib.contextmanager
def suppress_stdout():
    with open(os.devnull, 'w') as devnull:
        old_stdout = sys.stdout
        sys.stdout = devnull
        try:
            yield
        finally:
            sys.stdout = old_stdout

